# ---- Chips Square environment ----
# Copy to .env.local (Next.js) or .env (scripts). Never commit real values.

# Leave DATABASE_URL empty to use the local PGlite database in ./.pglite — zero setup, dev only.
# Set it to run against real Postgres (Neon / Supabase / Railway), which is what production uses.
# DATABASE_URL=postgresql://user:pass@host:5432/chips?sslmode=require
DATABASE_URL=

# Where the local PGlite files live (dev only).
PGLITE_DIR=./.pglite

# Public site URL, used in emails and links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Phase 3+: outbound notifications ---
# RESEND_API_KEY=
# OPS_EMAIL=you@example.com
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# --- Phase 5: payment gateway ---
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# --- Auth ---
# Signs the session cookie (HMAC-SHA256). REQUIRED in production; 32+ characters of randomness:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Dev falls back to a fixed insecure value so `npm run dev` works with no setup.
# AUTH_SECRET=
